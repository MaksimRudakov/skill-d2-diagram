# Purpose: access request process with swimlanes per role (flowchart example)
# Render: d2 --layout elk access-request.d2 access-request.svg
direction: down

classes: {
  start: {shape: oval; style: {fill: "#d3f9d8"; stroke: "#2b8a3e"}}                     # process start
  end: {shape: oval; style: {fill: "#e9ecef"; stroke: "#495057"}}                       # process end
  step: {style: {fill: "#e7f5ff"; stroke: "#1c7ed6"}}                                   # action / task
  decision: {shape: diamond; style: {fill: "#fff3bf"; stroke: "#f59f00"}}               # question with yes/no edges
  io: {shape: parallelogram; style: {fill: "#f3f0ff"; stroke: "#6741d9"}}               # input / output, form, request
  document: {shape: page; style: {fill: "#ffffff"; stroke: "#868e96"}}                  # document, report, ticket
}

requester: "Requester" {
  begin: "Needs access" {class: start}
  form: "Fill in the access request form\nresource · level · reason · expiry" {class: io}
  fix: "Update the request" {class: step}
  begin -> form
}

owner: "Resource owner" {
  review: "Is the access justified?" {class: decision}
}

devops: "DevOps on duty" {
  prod: "Production resource?" {class: decision}
  security: "Security sign-off" {class: step}
  grant: "Grant access\nleast privilege, with expiry" {class: step}
  record: "Access log entry" {class: document}
  prod -> security: "yes"
  security -> grant
  prod -> grant: "no"
  grant -> record
}

done: "Requester notified" {class: end}

requester.form -> owner.review
owner.review -> devops.prod: "yes"
owner.review -> requester.fix: "no, needs details"
requester.fix -> requester.form: "resubmit"
devops.record -> done

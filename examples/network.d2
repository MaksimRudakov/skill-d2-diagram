# Purpose: network segmentation of a typical two-site setup, version for people outside the team
# Classification: none (no addresses, vendors or host names)
# Render: d2 --layout elk network.d2 network.svg
direction: down

classes: {
  zone: {style: {fill: "#eef4fb"; stroke: "#4a78a8"}}          # cluster, data center, VPC
  outside: {style: {fill: "#f7f7f2"; stroke: "#8a8a70"}}       # internet, everything outside
  mgmt: {style: {fill: "#eeeeee"; stroke: "#666666"}}          # management network / tooling
  app: {style: {fill: "#dcebd8"; stroke: "#5b8c51"}}           # applications, workloads, data sources
  store: {style: {fill: "#e0f2f1"; stroke: "#00796b"}}         # databases, object and backup storage
  lb: {style: {fill: "#fff8e1"; stroke: "#d4a017"}}            # load balancers, ingress, API gateways
  fw: {style: {fill: "#fde8e8"; stroke: "#c0392b"}}            # firewalls, WAF
  net: {style: {fill: "#eceff1"; stroke: "#546e7a"}}           # routers, switches, network core
  external: {style: {fill: "#f5f5f5"; stroke: "#9e9e9e"; stroke-dash: 3}}              # external systems
  control: {style: {stroke: "#0b7285"; font-color: "#0b7285"}}                   # teal: control plane, sync, BGP/OSPF
  vpn: {style: {stroke: "#7048e8"; font-color: "#7048e8"; stroke-dash: 3}}       # violet, dashed
  public: {style: {stroke: "#ae3ec9"; font-color: "#ae3ec9"; stroke-width: 3}}   # magenta, thick: public traffic
}

internet: "Internet" {
  class: outside
  users: "Customers" {shape: person}
  partner: "Partner systems" {class: external}
}

dc: "Primary data center" {
  class: zone
  edge: "Border routers\n(2 internet uplinks)" {class: net}
  fw: "Firewall cluster (HA)" {class: fw}
  core: "Network core" {class: net}
  dmz: "DMZ" {
    class: zone
    lb: "Load balancer" {class: lb}
    waf: "Web application firewall" {class: fw}
  }
  prod: "Production segment" {
    class: zone
    k8s: "Kubernetes cluster (production)" {class: app}
    db: "Databases\nPostgreSQL · Redis" {class: store}
  }
  mgmt: "Management segment" {
    class: mgmt
    bastion: "Bastion host" {class: app}
    monitoring: "Monitoring" {class: app}
  }
  edge -> fw -> core
  core -> dmz.lb
  dmz.lb -> dmz.waf -> prod.k8s
  prod.k8s -> prod.db
  mgmt.bastion -> core: "admin access" {class: control}
}

dr: "Disaster recovery site" {
  class: zone
  standby: "Standby databases" {class: store}
}

internet.users -> dc.edge: "HTTPS" {class: public}
internet.partner -> dc.edge: "site-to-site VPN" {class: vpn}
dc.prod.db -> dr.standby: "replication" {class: control}

legend: "Legend: magenta — public traffic · violet dashed — VPN · teal — control and replication" {shape: text; near: bottom-center}

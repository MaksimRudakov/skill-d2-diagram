# Purpose: how an application is built, deployed and runs in Kubernetes
# Render: d2 --layout elk deployment.d2 deployment.svg
direction: down

classes: {
  zone: {style: {fill: "#eef4fb"; stroke: "#4a78a8"}}          # cluster, data center, VPC
  outside: {style: {fill: "#f7f7f2"; stroke: "#8a8a70"}}       # internet, everything outside
  app: {style: {fill: "#dcebd8"; stroke: "#5b8c51"}}           # applications, workloads, data sources
  service: {style: {fill: "#fdeeda"; stroke: "#b8863b"}}       # platform services and tools
  store: {style: {fill: "#e0f2f1"; stroke: "#00796b"}}         # databases, object and backup storage
  lb: {style: {fill: "#fff8e1"; stroke: "#d4a017"}}            # load balancers, ingress, API gateways
  external: {style: {fill: "#f5f5f5"; stroke: "#9e9e9e"; stroke-dash: 3}}              # external systems
  planned: {style: {fill: "#fffde7"; stroke: "#fbc02d"; stroke-dash: 5}}                # planned, not built yet
  logs: {style: {stroke: "#e8590c"; font-color: "#c2410c"}}                      # orange
  control: {style: {stroke: "#0b7285"; font-color: "#0b7285"}}                   # teal: control plane, sync, BGP/OSPF
}

dev: "Developers" {shape: person}

ci: "Delivery" {
  class: zone
  direction: right
  git: "Git repository\napp + Helm chart" {class: service}
  pipeline: "CI pipeline\ntest · build · scan" {class: service}
  registry: "Container registry" {class: store}
  gitops: "GitOps controller\n(Argo CD)" {class: service}
  git -> pipeline -> registry
  git -> gitops: "desired state" {class: control}
}

cluster: "Kubernetes cluster (production)" {
  class: zone
  direction: right
  ingress: "Ingress" {class: lb}
  api: "api\nDeployment · 3 replicas · HPA" {class: app}
  worker: "worker\nDeployment · queue consumers" {class: app}
  secrets: "External Secrets" {class: service}
  search: "Full-text search\n(planned)" {class: planned}
  ingress -> api
  api -> worker: "jobs"
  api -> search: "planned" {style.stroke-dash: 5}
}

data: "Managed services" {
  class: outside
  direction: right
  pg: "PostgreSQL" {class: store}
  queue: "Message queue" {class: store}
  s3: "Object storage" {class: store}
  vault: "Secrets manager" {class: external}
}


dev -> ci.git: "push / merge request"
ci.gitops -> cluster.api: "sync" {class: control}
ci.registry -> cluster.api: "pull image"
cluster.api -> data.pg
cluster.worker -> data.queue
cluster.worker -> data.s3
cluster.secrets -> data.vault: "read" {class: control}

# layout: stack the perimeters top to bottom
ci -> cluster: {style.opacity: 0}
cluster -> data: {style.opacity: 0}
